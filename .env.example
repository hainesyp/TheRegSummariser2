# Copy this file to .env and fill in the values for the provider you intend to use.
# Only the API key for the currently selected Ai__Provider is required.

# Which AI provider to use: OpenAI, Gemini, or Claude
Ai__Provider=OpenAI

Ai__OpenAI__ApiKey=
Ai__OpenAI__Model=gpt-4o-mini

Ai__Gemini__ApiKey=
Ai__Gemini__Model=gemini-2.0-flash

Ai__Claude__ApiKey=
Ai__Claude__Model=claude-sonnet-5
